# Copy to deploy/.env.production on the server (chmod 600). Never commit the real file.

# Public hostname; Caddy obtains a TLS certificate for it. Use "localhost" for a local trial.
DOMAIN=sho.example.com
# Image tags to run (pushed by the release workflow).
API_IMAGE=ghcr.io/OWNER/short-link-api:sha-abcdef0
WORKER_IMAGE=ghcr.io/OWNER/short-link-worker:sha-abcdef0
MIGRATE_IMAGE=ghcr.io/OWNER/short-link-migrate:sha-abcdef0

POSTGRES_PASSWORD=change-me-long-random
# openssl rand -base64 48
JWT_SECRET=change-me-to-at-least-32-random-characters

# Must match DOMAIN.
PUBLIC_BASE_URL=https://sho.example.com
CORS_ORIGINS=
BLOCKED_DESTINATION_HOSTS=
LOG_LEVEL=info
WORKER_CONCURRENCY=10
