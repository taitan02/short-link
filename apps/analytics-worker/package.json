{
  "name": "@short-link/analytics-worker",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "METRICS_PORT=${METRICS_PORT:-9465} nest start --watch --exec \"node --env-file-if-exists=../../.env\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "test:e2e": "jest --config test/jest-e2e.json --runInBand"
  },
  "jest": {
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ],
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node"
  },
  "dependencies": {
    "@nestjs/bullmq": "11.0.5",
    "@nestjs/common": "11.2.7",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.7",
    "@short-link/contracts": "workspace:*",
    "@short-link/observability": "workspace:*",
    "@short-link/prisma": "workspace:*",
    "bowser": "2.14.1",
    "bullmq": "6.3.12",
    "ioredis": "5.11.1",
    "nestjs-pino": "5.3.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "pino-pretty": "13.2.0"
  }
}
