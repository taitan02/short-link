# Copy to .env for local development. Never commit real secrets.

NODE_ENV=development
# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# API
PORT=3000
# Public origin used to build short URLs; also rejected as a destination to prevent loops.
PUBLIC_BASE_URL=http://localhost:3000

# Matches docker-compose.yml (host port 5442)
DATABASE_URL=postgresql://shortlink:shortlink@localhost:5442/shortlink

# Matches docker-compose.yml (host port 6389). Cache + rate-limit counters.
REDIS_URL=redis://localhost:6389/0
LINK_CACHE_TTL_SECONDS=600
# BullMQ (click events). Same dev instance, separate logical DB.
QUEUE_REDIS_URL=redis://localhost:6389/1

# openssl rand -base64 48
JWT_SECRET=change-me-to-at-least-32-random-characters
JWT_TTL_SECONDS=3600

# Reverse proxies in front of the API (0 when exposed directly)
TRUST_PROXY_HOPS=0
# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=
# Comma-separated destination hostnames to refuse (subdomains included)
BLOCKED_DESTINATION_HOSTS=

# Analytics worker
WORKER_CONCURRENCY=10
CLICK_RETENTION_DAYS=90
